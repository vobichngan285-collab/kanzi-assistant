<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.usb.host" android:required="false"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE"/>
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <queries>
      <intent><action android:name="android.intent.action.TTS_SERVICE"/></intent>
    </queries>
    <application
        android:allowBackup="false"
        android:label="蓝星向导 C110+变焦全屏"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/c110_network_security_config">
        <activity
            android:name="com.vobich.bluestar.cloudprobe.MainActivity"
            android:screenOrientation="portrait"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Isolated proven C110 mini VLC Activity with same bottom dock and camera-only settings. -->
        <activity android:name=".C110CameraActivity"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            android:exported="false"/>
        <!-- User manually changes native image size in OEM SJCAM Zone; this page
             only performs one real C110+ photo + one existing cloud OCR request. -->
        <activity android:name=".C110ResolutionLabActivity"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            android:exported="false"/>
        <!-- Disabled until the in-app USB auto-launch setting enables it.
             Android's USB host resolver/chooser, not an implicit background launch. -->
        <activity-alias
            android:name="com.vobich.bluestar.cloudprobe.UsbAttachEntry"
            android:targetActivity="com.vobich.bluestar.cloudprobe.MainActivity"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"/>
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_video_auto_start"/>
        </activity-alias>
    </application>
</manifest>
